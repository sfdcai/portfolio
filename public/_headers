# ==============================================================================
# Cloudflare Pages Custom Edge Security & High-Performance Caching Headers
# Host: amitbhardwaj.co.uk
# ==============================================================================

# Global security headers for all HTML/document responses
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Cache-Control: public, max-age=0, must-revalidate

# Immutable long-term caching for hashed Vite build artifacts
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Caching for fonts, icons, logos, webp/png assets
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# SEO, AI Bot Crawlers, and Sitemaps
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
